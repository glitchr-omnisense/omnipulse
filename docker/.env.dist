# The harness's settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnipulse reviews` says which review platforms are installed and
# configured; `reviews --live` asks, for real, each one whose key and place are set;
# `live` runs the providers' live tests (those that need no account, and GitHub Sponsors' with a token).

# Where the providers' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIPULSE_PLUGINS=../..

# omnipulse/google-reviews: a Places API (New) key and a place ID (ChIJ...); for the
# owner's side, an OAuth client, a refresh token (scope business.manage) and
# the location (accounts/<id>/locations/<id>).
GOOGLE_PLACES_KEY=
GOOGLE_PLACE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_LOCATION=

# omnipulse/tripadvisor: a Content API key and a location ID.
TRIPADVISOR_KEY=
TRIPADVISOR_LOCATION=
TRIPADVISOR_REFERER=

# omnipulse/trustpilot: an API key and a business unit ID; replying and
# inviting take the secret and a business user.
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT=
TRUSTPILOT_API_SECRET=
TRUSTPILOT_BUSINESS_USER_ID=

# omnipulse/github-sponsors' live tests: a GitHub token (read:user is enough for public sponsors).
OMNIPULSE_GITHUB_TOKEN=
